generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BOSS
  CASHIER
}

enum ProductStatus {
  ON_SALE
  OFF_SALE
}

enum PaymentMethod {
  CASH
  WECHAT
  ALIPAY
  CARD
  OTHER
  BALANCE
}

enum OrderStatus {
  NORMAL
  VOID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum InventoryChangeType {
  SALE
  REFUND
  INIT
  ADJUST
  VOID_BACK
  IMPORT
  PURCHASE
  STOCKTAKE
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StocktakeStatus {
  OPEN
  APPLIED
  CANCELLED
}

enum MemberTxnType {
  RECHARGE
  CONSUME
  REFUND
  EARN
  REDEEM
  ADJUST
}

enum ExpenseCategory {
  RESTOCK
  RENT
  UTILITIES
  PAYROLL
  FREIGHT
  OTHER
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  saleOrders     SaleOrder[]
  shifts         Shift[]
  inventoryLogs  InventoryLog[]
  auditLogs      AuditLog[]
  refundOrders   RefundOrder[]
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrders")
  stocktakeTasks StocktakeTask[] @relation("StocktakeCreator")
  memberTxns     MemberTxn[]     @relation("MemberTxnOperator")
  expenses       Expense[]       @relation("ExpenseOperator")
}

model Category {
  id       String  @id @default(uuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  sort     Int     @default(0)

  products Product[]
  stocktakeTasks StocktakeTask[]
  createdAt DateTime @default(now())

  @@index([parentId])
}

model Product {
  id         String        @id @default(uuid())
  name       String
  brand      String?
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id])
  unit       String        @default("件")
  status     ProductStatus @default(ON_SALE)
  remark     String?

  skus      Sku[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
}

model Sku {
  id          String        @id @default(uuid())
  productId   String
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  spec        String?
  retailPrice Int
  memberPrice Int?
  minPrice    Int?
  lastCost    Int?
  costAvg     Int?
  safetyStock Int           @default(0)
  status      ProductStatus @default(ON_SALE)

  barcodes      SkuBarcode[]
  inventory     Inventory?
  saleItems     SaleItem[]
  inventoryLogs InventoryLog[]
  purchaseItems PurchaseItem[]
  stocktakeItems StocktakeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model SkuBarcode {
  id      String   @id @default(uuid())
  skuId   String
  sku     Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  barcode String   @unique
  createdAt DateTime @default(now())
}

model Inventory {
  skuId     String   @id
  sku       Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  qty       Int      @default(0)
  updatedAt DateTime @updatedAt
}

model InventoryLog {
  id         String             @id @default(uuid())
  skuId      String
  sku        Sku                @relation(fields: [skuId], references: [id])
  type       InventoryChangeType
  change     Int
  after      Int
  refNo      String?
  note       String?
  operatorId String?
  operator   User?              @relation(fields: [operatorId], references: [id])
  createdAt  DateTime           @default(now())

  @@index([skuId, createdAt])
  @@index([createdAt])
}

model Shift {
  id           String      @id @default(uuid())
  cashierId    String
  cashier      User        @relation(fields: [cashierId], references: [id])
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  expectedCash Int?
  countedCash  Int?
  diff         Int?
  note         String?

  saleOrders SaleOrder[]

  @@index([cashierId, status])
}

model SaleOrder {
  id               String      @id @default(uuid())
  orderNo          String      @unique
  clientId         String?     @unique
  shiftId          String?
  shift            Shift?      @relation(fields: [shiftId], references: [id])
  cashierId        String
  cashier          User        @relation(fields: [cashierId], references: [id])
  memberId         String?
  member           Member?     @relation("MemberOrders", fields: [memberId], references: [id])
  status           OrderStatus @default(NORMAL)
  totalAmount      Int
  discountAmount   Int         @default(0)
  /** 积分抵扣金额（分），pointsUsed × 积分价值，入账时点快照 */
  pointsDiscount   Int         @default(0)
  /** 本单使用的积分数 */
  pointsUsed       Int         @default(0)
  /** 本单获得的积分数（按实收金额计算） */
  pointsEarned     Int         @default(0)
  payableAmount    Int
  remark           String?
  voidReason       String?
  voidById         String?
  offlineCreatedAt DateTime?
  createdAt        DateTime    @default(now())

  items    SaleItem[]
  payments Payment[]
  refunds  RefundOrder[]

  @@index([createdAt])
  @@index([shiftId])
  @@index([cashierId])
  @@index([memberId])
}

model SaleItem {
  id           String @id @default(uuid())
  orderId      String
  order        SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId        String
  sku          Sku       @relation(fields: [skuId], references: [id])
  productName  String
  spec         String?
  barcode      String?
  unit         String
  qty          Int
  unitPrice    Int
  subtotal     Int
  costSnapshot Int?
  refundedQty  Int       @default(0)

  refundItems RefundItem[]

  @@index([orderId])
  @@index([skuId])
}

model Payment {
  id      String        @id @default(uuid())
  orderId String
  order   SaleOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method  PaymentMethod
  amount  Int

  @@index([orderId])
}

model RefundOrder {
  id        String        @id @default(uuid())
  refundNo  String        @unique
  orderId   String
  order     SaleOrder     @relation(fields: [orderId], references: [id])
  shiftId   String?
  cashierId String
  cashier   User          @relation(fields: [cashierId], references: [id])
  amount    Int
  reason    String
  method    PaymentMethod
  createdAt DateTime      @default(now())

  items RefundItem[]

  @@index([orderId])
  @@index([createdAt])
}

model RefundItem {
  id         String    @id @default(uuid())
  refundId   String
  refund     RefundOrder @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem    @relation(fields: [saleItemId], references: [id])
  skuId      String
  qty        Int
  unitPrice  Int
  subtotal   Int
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------- 二期：采购 / 应付 ----------

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  contact   String?
  remark    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String        @id @default(uuid())
  orderNo     String        @unique
  supplierId  String
  supplier    Supplier      @relation(fields: [supplierId], references: [id])
  status      PurchaseStatus @default(DRAFT)
  totalAmount Int
  remark      String?
  operatorId  String?
  operator    User?         @relation("PurchaseOrders", fields: [operatorId], references: [id])
  receivedAt  DateTime?
  createdAt   DateTime      @default(now())

  items    PurchaseItem[]
  payments PurchasePayment[]

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseItem {
  id          String        @id @default(uuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId       String
  sku         Sku           @relation(fields: [skuId], references: [id])
  productName String
  spec        String?
  barcode     String?
  unit        String
  qty         Int
  /** 已入库数量（支持一张订单分批到货） */
  receivedQty Int           @default(0)
  unitCost    Int
  subtotal    Int

  @@index([orderId])
  @@index([skuId])
}

model PurchasePayment {
  id         String        @id @default(uuid())
  orderId    String
  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Int
  method     PaymentMethod @default(CASH)
  note       String?
  operatorId String?
  createdAt  DateTime      @default(now())

  @@index([orderId])
}

// ---------- 二期：盘点任务 ----------

model StocktakeTask {
  id              String         @id @default(uuid())
  taskNo          String         @unique
  status          StocktakeStatus @default(OPEN)
  scopeCategoryId String?
  scopeCategory   Category?      @relation(fields: [scopeCategoryId], references: [id])
  note            String?
  creatorId       String?
  creator         User?          @relation("StocktakeCreator", fields: [creatorId], references: [id])
  appliedAt       DateTime?
  createdAt       DateTime       @default(now())

  items StocktakeItem[]
}

model StocktakeItem {
  id          String        @id @default(uuid())
  taskId      String
  task        StocktakeTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skuId       String
  sku         Sku           @relation(fields: [skuId], references: [id])
  productName String
  spec        String?
  unit        String
  /** 建任务时的账面库存快照 */
  snapshotQty Int
  /** 实盘数量；null = 未盘 */
  countedQty  Int?

  @@index([taskId])
  @@index([skuId])
}

// ---------- 二期：会员储值 / 积分 ----------

model Member {
  id        String   @id @default(uuid())
  /** 会员码（M 前缀 + 8 位随机字母数字），可作为会员卡号扫码识别 */
  code      String   @unique
  name      String
  phone     String?
  /** 储值余额（分）。非负由迁移 SQL 的 CHECK 约束兜底（应用层校验之外的第二道防线） */
  balance   Int      @default(0)
  /** 积分。非负约束同上 */
  points    Int      @default(0)
  active    Boolean  @default(true)
  remark    String?
  createdAt DateTime @default(now())

  txns  MemberTxn[]
  orders SaleOrder[] @relation("MemberOrders")

  @@index([phone])
  @@index([name])
}

model MemberTxn {
  id           String        @id @default(uuid())
  memberId     String
  member       Member        @relation(fields: [memberId], references: [id])
  type         MemberTxnType
  /** 储值余额变动（分），正为入账负为扣减 */
  amount       Int           @default(0)
  balanceAfter Int
  pointsChange Int           @default(0)
  pointsAfter  Int
  refNo        String?
  note         String?
  operatorId   String?
  operator     User?           @relation("MemberTxnOperator", fields: [operatorId], references: [id])
  createdAt    DateTime      @default(now())

  @@index([memberId, createdAt])
}

// ---------- 二期：支出记账 ----------

model Expense {
  id         String         @id @default(uuid())
  date       DateTime
  category   ExpenseCategory
  amount     Int
  title      String
  note       String?
  operatorId String?
  operator   User?          @relation("ExpenseOperator", fields: [operatorId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([date])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
