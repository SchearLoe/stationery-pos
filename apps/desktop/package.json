{
  "name": "@pos/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "文具店收银系统 - Windows 桌面收银端",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "pnpm build:electron && concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "pnpm typecheck && vite build && pnpm build:electron",
    "typecheck": "vue-tsc --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --win"
  },
  "build": {
    "appId": "com.schearloe.stationery-pos",
    "productName": "文具店收银系统",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@pos/shared-types": "workspace:*",
    "axios": "^1.7.9",
    "element-plus": "^2.9.0",
    "iconv-lite": "^0.7.3",
    "idb-keyval": "^6.3.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.10",
    "wait-on": "^8.0.1"
  }
}
